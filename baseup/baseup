#!/usr/bin/env bash
set -e

# baseup - Base release installer
# Downloads release binaries from GitHub releases and installs them locally.

# NOTE: If you change this script, increment the version below.
BASEUP_INSTALLER_VERSION="0.1.0"

BASEUP_REPO="${BASEUP_REPO:-base/base}"
BASEUP_REPO_REF="${BASEUP_REPO_REF:-main}"
BASEUP_HOME="${BASEUP_HOME:-$HOME/.base}"
BIN_DIR="${BASE_BIN_DIR:-$BASEUP_HOME/bin}"
BASEUP_HOST_BASE_URL="${BASEUP_HOST_BASE_URL:-https://raw.githubusercontent.com/${BASEUP_REPO}/${BASEUP_REPO_REF}/baseup}"
BASEUP_BIN_URL="${BASEUP_BIN_URL:-${BASEUP_HOST_BASE_URL}/baseup}"
BASEUP_BIN_PATH="$BIN_DIR/baseup"

DEFAULT_BINS=("base-reth-node" "basectl")
SELECTED_BINS=()
VERSION=""

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() {
    echo -e "${GREEN}info${NC}: $1"
}

warn() {
    echo -e "${YELLOW}warn${NC}: $1"
}

error() {
    echo -e "${RED}error${NC}: $1"
    exit 1
}

array_contains() {
    local needle="$1"
    shift
    local value
    for value in "$@"; do
        if [[ "$value" == "$needle" ]]; then
            return 0
        fi
    done
    return 1
}

version_gt() {
    [ "$1" = "$2" ] && return 1

    local ver1="${1#v}"
    local ver2="${2#v}"
    local major1 minor1 patch1
    local major2 minor2 patch2

    IFS=. read -r major1 minor1 patch1 <<EOF
$ver1
EOF
    IFS=. read -r major2 minor2 patch2 <<EOF
$ver2
EOF

    [ "$major1" -gt "$major2" ] && return 0
    [ "$major1" -lt "$major2" ] && return 1
    [ "$minor1" -gt "$minor2" ] && return 0
    [ "$minor1" -lt "$minor2" ] && return 1
    [ "$patch1" -gt "$patch2" ] && return 0
    [ "$patch1" -lt "$patch2" ] && return 1

    return 1
}

version() {
    echo "$BASEUP_INSTALLER_VERSION"
    exit 0
}

can_download() {
    command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1
}

download_url() {
    local url="$1"
    local output_path="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -#fL "$url" -o "$output_path"
    elif command -v wget >/dev/null 2>&1; then
        wget --show-progress -q -O "$output_path" "$url"
    else
        error "Neither curl nor wget found. Please install one of them."
    fi
}

fetch_text() {
    local url="$1"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- "$url"
    else
        error "Neither curl nor wget found. Please install one of them."
    fi
}

download_file() {
    local tag="$1"
    local filename="$2"
    local output_dir="$3"
    local url="https://github.com/${BASEUP_REPO}/releases/download/${tag}/${filename}"
    local output_path="$output_dir/$filename"

    info "Downloading $filename..."
    if ! download_url "$url" "$output_path"; then
        error "Failed to download $filename from $url"
    fi
}

compute_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

check_installer_up_to_date() {
    if ! can_download; then
        return
    fi

    local remote_script
    remote_script="$(fetch_text "$BASEUP_BIN_URL" 2>/dev/null || true)"
    if [[ -z "$remote_script" ]]; then
        return
    fi

    local remote_version
    remote_version="$(printf '%s\n' "$remote_script" | grep '^BASEUP_INSTALLER_VERSION=' | sed -E 's/BASEUP_INSTALLER_VERSION="(.+)"/\1/')"
    if [[ -z "$remote_version" ]]; then
        return
    fi

    if version_gt "$remote_version" "$BASEUP_INSTALLER_VERSION"; then
        echo ""
        warn "Your baseup version ($BASEUP_INSTALLER_VERSION) is outdated."
        warn "Latest version is $remote_version."
        warn "Run 'baseup --update' to update to the latest version."
        echo ""
    fi
}

update_baseup() {
    mkdir -p "$BIN_DIR"

    if ! can_download; then
        error "Neither curl nor wget found. Please install one of them."
    fi

    local tmp_file
    tmp_file="$(mktemp 2>/dev/null || mktemp -t baseup)"
    trap "rm -f '$tmp_file'" EXIT

    info "Downloading latest baseup..."
    if ! download_url "$BASEUP_BIN_URL" "$tmp_file" 2>/dev/null; then
        error "Failed to download baseup update"
    fi

    local remote_version
    remote_version="$(grep '^BASEUP_INSTALLER_VERSION=' "$tmp_file" | sed -E 's/BASEUP_INSTALLER_VERSION="(.+)"/\1/')"
    if [[ -z "$remote_version" ]]; then
        error "Failed to determine remote baseup version"
    fi

    if ! version_gt "$remote_version" "$BASEUP_INSTALLER_VERSION"; then
        info "baseup is already up to date (version $BASEUP_INSTALLER_VERSION)"
        exit 0
    fi

    info "Updating baseup from $BASEUP_INSTALLER_VERSION to $remote_version..."
    if cp "$tmp_file" "$BASEUP_BIN_PATH" 2>/dev/null; then
        chmod 755 "$BASEUP_BIN_PATH"
    elif sudo cp "$tmp_file" "$BASEUP_BIN_PATH" 2>/dev/null; then
        sudo chmod 755 "$BASEUP_BIN_PATH"
    else
        error "Failed to update baseup at $BASEUP_BIN_PATH. Try running with sudo."
    fi

    echo ""
    info "baseup updated successfully to version $remote_version"
    exit 0
}

normalize_bin_name() {
    case "$1" in
        all)
            echo "all"
            ;;
        node | reth-node | base-reth-node)
            echo "base-reth-node"
            ;;
        ctl | basectl)
            echo "basectl"
            ;;
        *)
            return 1
            ;;
    esac
}

add_selected_bin() {
    local normalized
    normalized="$(normalize_bin_name "$1")" || error "Unknown binary '$1'. Valid values: base-reth-node, basectl, all."

    if [[ "$normalized" == "all" ]]; then
        local item
        for item in "${DEFAULT_BINS[@]}"; do
            add_selected_bin "$item"
        done
        return
    fi

    if ! array_contains "$normalized" "${SELECTED_BINS[@]}"; then
        SELECTED_BINS+=("$normalized")
    fi
}

resolve_selected_bins() {
    if [[ ${#SELECTED_BINS[@]} -eq 0 ]]; then
        SELECTED_BINS=("${DEFAULT_BINS[@]}")
    fi
}

detect_platform() {
    local platform
    platform="$(uname -s | tr '[:upper:]' '[:lower:]')"

    case "$platform" in
        linux*)
            echo "linux"
            ;;
        darwin* | mac*)
            echo "darwin"
            ;;
        *)
            error "Unsupported platform: $platform"
            ;;
    esac
}

detect_arch() {
    local arch
    arch="$(uname -m)"

    case "$arch" in
        x86_64 | x64 | amd64)
            if [[ "$(uname -s)" == "Darwin" ]] && [[ "$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" == "1" ]]; then
                echo "arm64"
            else
                echo "amd64"
            fi
            ;;
        arm64 | aarch64)
            echo "arm64"
            ;;
        *)
            warn "Unknown architecture: $arch, defaulting to amd64"
            echo "amd64"
            ;;
    esac
}

detect_target() {
    local platform="$1"
    local arch="$2"

    case "$platform" in
        darwin)
            case "$arch" in
                arm64)
                    echo "aarch64-apple-darwin"
                    ;;
                amd64)
                    error "Intel macOS binaries are not published by this repository."
                    ;;
                *)
                    error "Unsupported macOS architecture: $arch"
                    ;;
            esac
            ;;
        linux)
            case "$arch" in
                arm64)
                    echo "aarch64-unknown-linux-gnu"
                    ;;
                amd64)
                    echo "x86_64-unknown-linux-gnu"
                    ;;
                *)
                    error "Unsupported Linux architecture: $arch"
                    ;;
            esac
            ;;
        *)
            error "Unsupported platform: $platform"
            ;;
    esac
}

get_latest_version() {
    if ! can_download; then
        error "Neither curl nor wget found. Please install one of them."
    fi

    local api_url="https://api.github.com/repos/${BASEUP_REPO}/releases/latest"
    local version
    version="$(fetch_text "$api_url" 2>/dev/null | grep '"tag_name":' | head -n 1 | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/')"

    if [[ -z "$version" ]]; then
        error "Failed to fetch the latest release from GitHub. Try --install <tag>."
    fi

    echo "$version"
}

install_binary() {
    local src="$1"
    local binary_name="$2"
    local destination="$BIN_DIR/$binary_name"
    local backup="$destination.old"

    info "Installing $binary_name to $destination..."
    mv -f "$destination" "$backup" 2>/dev/null || true

    if cp "$src" "$destination" 2>/dev/null; then
        chmod 755 "$destination"
        rm -f "$backup" 2>/dev/null || true
        return
    fi

    if sudo cp "$src" "$destination" 2>/dev/null; then
        sudo chmod 755 "$destination"
        rm -f "$backup" 2>/dev/null || true
        return
    fi

    mv -f "$backup" "$destination" 2>/dev/null || true
    error "Failed to install $binary_name to $destination. Try running with sudo."
}

usage() {
    cat <<'EOF'
Usage: baseup [OPTIONS]

Options:
  -v, --version         Print the baseup installer version
  -i, --install <VER>   Install a specific release tag (for example: v0.6.0)
  -b, --bin <NAME>      Install only one binary (base-reth-node, basectl, all)
  -U, --update          Update baseup itself
  -h, --help            Show this help message

Examples:
  baseup
  baseup -i v0.6.0
  baseup --bin base-reth-node
  baseup --bin basectl
  baseup --update
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -v | --version)
            version
            ;;
        -i | --install)
            [[ $# -ge 2 ]] || error "Missing value for $1"
            VERSION="$2"
            shift 2
            ;;
        -b | --bin)
            [[ $# -ge 2 ]] || error "Missing value for $1"
            add_selected_bin "$2"
            shift 2
            ;;
        -U | --update)
            update_baseup
            ;;
        -h | --help)
            usage
            ;;
        *)
            error "Unknown option: $1. Use --help for usage information."
            ;;
    esac
done

main() {
    check_installer_up_to_date

    info "Installing Base release binaries..."

    mkdir -p "$BIN_DIR"

    local platform
    local arch
    local target
    platform="$(detect_platform)"
    arch="$(detect_arch)"
    target="$(detect_target "$platform" "$arch")"
    resolve_selected_bins

    info "Detected platform: $platform ($arch)"

    if [[ -z "$VERSION" ]]; then
        info "Fetching the latest release version..."
        VERSION="$(get_latest_version)"
    fi

    local version_tag="$VERSION"
    info "Installing release $version_tag"

    local tmp_dir
    tmp_dir="$(mktemp -d 2>/dev/null || mktemp -d -t baseup)"
    trap "rm -rf '$tmp_dir'" EXIT

    local binary_name
    for binary_name in "${SELECTED_BINS[@]}"; do
        local archive_name
        local archive_path
        local checksum_path
        local expected_checksum
        local actual_checksum
        local extract_dir
        local binary_path

        archive_name="${binary_name}-${version_tag}-${target}.tar.gz"
        archive_path="$tmp_dir/$archive_name"
        checksum_path="${archive_path}.sha256"
        extract_dir="$tmp_dir/${binary_name}-extract"

        download_file "$version_tag" "$archive_name" "$tmp_dir"
        download_file "$version_tag" "${archive_name}.sha256" "$tmp_dir"

        expected_checksum="$(head -n 1 "$checksum_path" | awk '{print $1}')"
        actual_checksum="$(compute_sha256 "$archive_path")"

        if [[ "$expected_checksum" != "$actual_checksum" ]]; then
            error "Checksum verification failed for $archive_name"
        fi

        info "Checksum verified for $archive_name"

        mkdir -p "$extract_dir"
        tar -xzf "$archive_path" -C "$extract_dir"
        binary_path="$(find "$extract_dir" -name "$binary_name" -type f | head -n 1)"

        if [[ -z "$binary_path" ]]; then
            error "Could not find $binary_name in $archive_name"
        fi

        install_binary "$binary_path" "$binary_name"
    done

    echo ""
    info "Installed release $version_tag successfully"
    echo ""

    if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
        warn "$BIN_DIR is not in your PATH"
        echo "  Add it to your shell config:"
        echo "    export PATH=\"$BIN_DIR:\$PATH\""
        echo ""
    else
        local installed_binary
        for installed_binary in "${SELECTED_BINS[@]}"; do
            info "Run '$installed_binary --help' to verify the install"
        done
    fi
}

main
