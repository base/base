# Recipes for the action test framework.
# Import this module from the root Justfile with:
#   mod actions 'actions'

# Default to display help menu
default:
    @just --list --list-prefix '  actions::'

# Run all action tests
test:
    cargo nextest run -p base-action-harness -p base-action-fixtures

# Run all action tests with the CI profile
test-ci:
    cargo nextest run -P ci --locked -p base-action-harness -p base-action-fixtures --cargo-profile ci

# Run action tests with output shown (useful when debugging a failing test)
test-verbose:
    cargo nextest run -p base-action-harness -p base-action-fixtures --no-capture

# Run the fixture capture command.
#
# Defaults are read from actions/fixtures/.env when present. Extra CLI args are
# forwarded to the capture binary, for example:
#   just actions fixtures --l2-start 1 --l2-end 1
fixtures *args:
    cargo run -p base-action-fixtures --bin base-action-fixture-capture -- {{args}}

# Check the action crates without running tests
check:
    cargo check -p base-action-harness -p base-action-fixtures

# Clippy the action crates
lint:
    cargo clippy -p base-action-harness -p base-action-fixtures --all-targets -- -D warnings

# Clippy the action crates with the CI profile
lint-ci:
    cargo clippy --locked -p base-action-harness -p base-action-fixtures --all-targets --profile ci -- -D warnings
