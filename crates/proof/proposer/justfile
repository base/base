l1_rpc := env_var_or_default("L1_RPC", "https://ethereum-sepolia-rpc.publicnode.com")
l2_rpc := env_var_or_default("L2_RPC", "https://sepolia.base.org")
enclave_rpc := env_var_or_default("ENCLAVE_RPC", "http://localhost:1234")
verifier_addr := env_var_or_default("VERIFIER_ADDR", "0xaddD538424b2549a13deE55dE55174516Ed037BC")
poll_interval := env_var_or_default("POLL_INTERVAL", "6s")
min_proposal_interval := env_var_or_default("MIN_PROPOSAL_INTERVAL", "1")
common_args := "--l1-eth-rpc " + l1_rpc + " --l2-eth-rpc " + l2_rpc + " --rollup-rpc " + l2_rpc + " --enclave-rpc " + enclave_rpc + " --poll-interval " + poll_interval + " --min-proposal-interval " + min_proposal_interval + " --l2-reth --skip-tls-verify -vvvv"

default:
    @just --list

run *ARGS:
    cargo run --bin base-proposer -- {{ARGS}}

# Run with Base Sepolia development configuration
run-dev *ARGS:
    cargo run --bin base-proposer -- \
        {{common_args}} \
        --onchain-verifier-addr {{verifier_addr}} \
        --metrics.enabled \
        --metrics.addr 0.0.0.0 \
        --metrics.port 7300 \
        {{ARGS}}

# Run with local enclave server
run-local *ARGS:
    cargo run --bin base-proposer -- \
        {{common_args}} \
        --onchain-verifier-addr 0x0000000000000000000000000000000000000000 \
        {{ARGS}}

help:
    cargo run --bin base-proposer -- --help
