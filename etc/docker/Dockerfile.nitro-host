# syntax=docker/dockerfile:1

# Optional ca_bundle secret mounts support custom CA bundles; see etc/docker/README.md.
# Builds base-prover-nitro-host — the worker that claims proof jobs and forwards
# them to the Nitro Enclave over vsock.

# --- Builder ---
FROM --platform=linux/amd64 rust:1.95-trixie@sha256:443dd9a3260cf23c22fc05051dd5661dd7b4028d3d25dbaffab6563b63c3539c AS builder
WORKDIR /app
# Export CA bundle env vars only when /run/secrets/ca_bundle is mounted, then exec the RUN string.
# The secret mount itself must still be declared on each network-fetching RUN.
SHELL ["/bin/sh", "-c", "if [ -f /run/secrets/ca_bundle ]; then export SSL_CERT_FILE=/run/secrets/ca_bundle CURL_CA_BUNDLE=/run/secrets/ca_bundle CARGO_HTTP_CAINFO=/run/secrets/ca_bundle GIT_SSL_CAINFO=/run/secrets/ca_bundle NODE_EXTRA_CA_CERTS=/run/secrets/ca_bundle; fi; exec /bin/sh -c \"$1\"", "--"]

RUN --mount=type=secret,id=ca_bundle,target=/run/secrets/ca_bundle,required=false,mode=0444 \
    if [ -f /run/secrets/ca_bundle ]; then apt_ca="-o Acquire::https::CaInfo=/run/secrets/ca_bundle"; else apt_ca=""; fi && \
    apt-get $apt_ca update && \
    apt-get $apt_ca install -y --no-install-recommends \
      git libclang-dev pkg-config curl build-essential protobuf-compiler && \
    rm -rf /var/lib/apt/lists/*

COPY . .

ARG PROFILE=release
ARG CARGO_FEATURES=""
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/app/target,id=prover-nitro-host-target,sharing=locked \
    --mount=type=secret,id=ca_bundle,target=/run/secrets/ca_bundle,required=false \
    cargo build --profile $PROFILE --locked --package base-prover-nitro-host --bin base-prover-nitro-host $CARGO_FEATURES && \
    cp target/$([ "$PROFILE" = "dev" ] && echo debug || echo $PROFILE)/base-prover-nitro-host ./base-prover-nitro-host

# --- Runtime ---
FROM --platform=linux/amd64 debian:trixie-slim@sha256:1d3c811171a08a5adaa4a163fbafd96b61b87aa871bbc7aa15431ac275d3d430
RUN --mount=type=secret,id=ca_bundle,target=/run/secrets/ca_bundle,required=false,mode=0444 \
    if [ -f /run/secrets/ca_bundle ]; then apt_ca="-o Acquire::https::CaInfo=/run/secrets/ca_bundle"; else apt_ca=""; fi && \
    apt-get $apt_ca update && \
    apt-get $apt_ca install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -r -m -s /sbin/nologin base

WORKDIR /app
COPY --from=builder /app/base-prover-nitro-host ./
COPY etc/docker/nitro-host/entrypoint.sh ./entrypoint.sh

USER base

ENTRYPOINT ["./entrypoint.sh"]
