# Public Base node image (`ghcr.io/base/node-reth`).
# Builds this tree directly — no versions.env clone.

ARG RUST_VERSION=1.95.0

FROM public.ecr.aws/docker/library/rust:${RUST_VERSION}-trixie AS rust-builder-base

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      git libclang-dev pkg-config curl build-essential cmake && \
    rm -rf /var/lib/apt/lists/*

FROM rust-builder-base AS reth-base

WORKDIR /app

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/app/target,id=node-reth-maxperf,sharing=locked \
    cargo build --locked --bin base-reth-node --bin base-consensus --bin basectl --profile maxperf && \
    cp /app/target/maxperf/basectl /app/target/maxperf/base-consensus /app/target/maxperf/base-reth-node /app/

FROM ubuntu:24.04

RUN apt-get update && \
    apt-get install -y curl supervisor && \
    rm -rf /var/lib/apt/lists/*
RUN mkdir -p /var/log/supervisor

WORKDIR /app

COPY --from=reth-base /app/basectl ./
COPY --from=reth-base /app/base-consensus ./
COPY --from=reth-base /app/base-reth-node ./
COPY etc/scripts/node/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY etc/scripts/node/execution-entrypoint .
COPY etc/scripts/node/consensus-entrypoint .
RUN chmod +x execution-entrypoint consensus-entrypoint

CMD ["/usr/bin/supervisord"]
