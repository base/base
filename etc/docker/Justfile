set dotenv-path := "devnet-env"
set working-directory := '../..'

_ha := "-f etc/docker/docker-compose.yml -f etc/docker/docker-compose.ha.yml"
_base := "-f etc/docker/docker-compose.yml"
_env := "--env-file etc/docker/devnet-env"
_yaml_to_env := "etc/scripts/yaml-to-compose-env.py"

# Show devnet commands
default:
    @just --justfile {{source_file()}} --list

# Stops devnet, deletes data, and starts fresh (3-node HA conductor cluster)
up zk='dry-run':
    just --justfile {{ source_file() }} _up-devnet "ha" {{ quote(zk) }}

# Stops devnet, deletes data, and starts fresh with a single sequencer (no conductor)
up-single zk='dry-run':
    just --justfile {{ source_file() }} _up-devnet "base" {{ quote(zk) }}

# Stops devnet, deletes data, and starts fresh with profiling (Pyroscope + optimized builds)
profiling: down _build-setup-image (_build-rust-images "devnet" "profiling")
    docker compose {{ _env }} {{ _ha }} --profile profiling up -d --no-build

# Stops devnet and deletes all data
down:
    -docker compose {{ _env }} {{ _ha }} --profile profiling down
    -docker run --rm -v "$(pwd)/.devnet:/devnet" alpine sh -c 'rm -rf /devnet/*'

# Shows devnet block numbers and sync status
status:
    ./etc/scripts/devnet/status.sh

# Shows peer counts and unsafe L2 height for each L2 node
peer-status:
    ./etc/scripts/devnet/peer-status.sh

# Shows devnet container status
ps *services:
    docker compose {{ _env }} {{ _ha }} ps {{ services }}

# Shows funded test accounts with live balances and nonces
accounts:
    ./etc/scripts/devnet/accounts.sh

# Sends test transactions to L1 and L2
smoke:
    ./etc/scripts/devnet/smoke.sh

# Deploys, updates, or inspects the normal devnet L1 upgrade-signal contract
upgrade-signal *args:
    ./etc/scripts/devnet/upgrade-signal.sh {{ args }}

# Moves one devnet upgrade to latest L2 timestamp + offset seconds
upgrade-signal-future upgrade='azul' offset='120':
    ./etc/scripts/devnet/upgrade-signal.sh move-future {{ quote(upgrade) }} --offset {{ quote(offset) }}

# Runs full devnet checks (status + smoke tests)
checks: status smoke

# Sends an ingress transaction and verifies transaction events reached audit-archiver Postgres
tx-observability-smoke:
    ./etc/scripts/devnet/transaction-events-smoke.sh

# Stream FB's from the builder via websocket
flashblocks:
    @command -v flashblocks-websocket-client >/dev/null 2>&1 || go install github.com/danyalprout/flashblocks-websocket-client@latest
    flashblocks-websocket-client ws://localhost:${L2_BUILDER_FLASHBLOCKS_PORT}

# Stream logs from devnet containers (optionally specify container names)
logs *containers:
    docker compose {{ _env }} {{ _ha }} logs -f {{ containers }}

# Stream logs from the primary unified sequencer
sequencer-logs:
    docker compose {{ _env }} {{ _ha }} logs -f base-builder

# Stream logs from the devnet ZK prover services
zk-logs *containers:
    docker compose {{ _env }} {{ _ha }} logs -f {{ if containers == "" { "base-prover-service base-prover-zk-host prover-service-postgres" } else { containers } }}

# Stop only the devnet ZK prover services, leaving the rest of devnet running
zk-down:
    -docker compose {{ _env }} {{ _ha }} stop base-prover-zk-host base-prover-service prover-service-postgres
    -docker compose {{ _env }} {{ _ha }} rm -f base-prover-zk-host base-prover-service prover-service-postgres

# Follow the active raft leader's unified sequencer logs, switching automatically on failover
follow-leader:
    ./etc/scripts/devnet/follow-leader.sh

# Stop the active sequencer and transfer raft leadership (optionally to node 0, 1, or 2)
transfer-leader to='':
    ./etc/scripts/devnet/transfer-leader.sh {{ to }}

# TUI dashboard: HA conductor cluster monitor (requires devnet running)
conductor:
    cargo run --quiet -p basectl -- -c devnet monitor conductor

# Stops devnet+ingress, deletes data, and starts fresh with full ingress stack
ingress: ingress-down _build-setup-image (_build-rust-images "ingress" "dev")
    docker compose {{ _env }} {{ _base }} -f etc/docker/docker-compose.ingress.yml up -d --no-build

# Stops devnet+ingress and deletes all data
ingress-down:
    -docker compose {{ _env }} {{ _base }} -f etc/docker/docker-compose.ingress.yml down
    -docker run --rm -v "$(pwd)/.devnet:/devnet" alpine sh -c 'rm -rf /devnet/*'

# Stream logs from devnet+ingress containers (optionally specify container names)
ingress-logs *containers:
    docker compose {{ _env }} {{ _base }} -f etc/docker/docker-compose.ingress.yml logs -f {{ containers }}

# Builds one of the shared Rust service images (default: base)
build-image target='base' profile='dev':
    #!/usr/bin/env bash
    set -euo pipefail
    case "$(uname -m)" in
      x86_64)       platform_pair="linux-amd64" ;;
      arm64|aarch64) platform_pair="linux-arm64" ;;
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
    esac
    elf_require=1
    case "{{ profile }}" in
      dev|profiling)
        case "{{ target }}" in
          zk-host|devnet) elf_require=0 ;;
        esac
        ;;
    esac
    PROFILE="{{ profile }}" ZK_HOST_PROFILE=release BASE_SUCCINCT_ELF_REQUIRE="${elf_require}" PLATFORM_PAIR="${platform_pair}" docker buildx bake -f etc/docker/docker-bake.hcl "{{ target }}" --load

# Prepares Docker images needed for system tests
pull-images:
    docker build --load -t devnet-setup:local -f etc/docker/Dockerfile.devnet .
    docker pull ghcr.io/paradigmxyz/reth:v1.11.4
    docker pull sigp/lighthouse:v8.0.1

# Runs system tests (requires Docker)
tests: _install-nextest _build-contracts
    cargo nextest run -p base-system-tests

# Runs system tests with ci profile for minimal disk usage
tests-ci: _install-nextest _build-contracts
    cargo nextest run -P ci --locked -p base-system-tests --cargo-profile ci

# Runs system test benchmarks
bench name:
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ name }}" in
      b20-zk-proving) cargo bench -p base-system-tests --bench b20_zk_proving ;;
      *) echo "unknown system test bench: {{ name }}" >&2; exit 1 ;;
    esac

[private]
_install-nextest:
    @command -v cargo-nextest >/dev/null 2>&1 || cargo install cargo-nextest

[private]
_build-setup-image:
    docker build --load -t devnet-setup:local -f etc/docker/Dockerfile.devnet .

[private]
_build-rust-images group profile='dev' elf_require_override='':
    #!/usr/bin/env bash
    set -euo pipefail
    case "$(uname -m)" in
      x86_64)       platform_pair="linux-amd64" ;;
      arm64|aarch64) platform_pair="linux-arm64" ;;
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
    esac
    elf_require=1
    case "{{ profile }}" in
      dev|profiling)
        case "{{ group }}" in
          devnet|ingress) elf_require=0 ;;
        esac
        ;;
    esac
    if [ -n "{{ elf_require_override }}" ]; then
      elf_require="{{ elf_require_override }}"
    fi
    PROFILE="{{ profile }}" ZK_HOST_PROFILE=release BASE_SUCCINCT_ELF_REQUIRE="${elf_require}" PLATFORM_PAIR="${platform_pair}" docker buildx bake -f etc/docker/docker-bake.hcl "{{ group }}" --load

[private]
_up-devnet compose_profile zk:
    #!/usr/bin/env bash
    set -euo pipefail
    compose_profile={{ quote(compose_profile) }}
    zk_mode={{ quote(zk) }}
    zk_mode="${zk_mode#zk=}"

    case "$compose_profile" in
      ha) compose_files=({{ _ha }}) ;;
      base) compose_files=({{ _base }}) ;;
      *)
        echo "ERROR: compose profile must be 'ha' or 'base' (got '${compose_profile}')" >&2
        exit 1
        ;;
    esac

    # Starts L1 + setup, deploys the upgrade-signal contract, then starts the rest.
    # Extra arguments are passed to `docker compose` (e.g. `--env-file`).
    start_devnet_with_upgrade_signal() {
      local setup_l2_status
      local compose_cmd=(docker compose {{ _env }} "$@")
      local upgrade_signal_env_files="${UPGRADE_SIGNAL_ENV_FILES:-}"
      compose_cmd+=("${compose_files[@]}")

      "${compose_cmd[@]}" up -d --no-build --remove-orphans setup-l1 l1-el l1-cl l1-vc
      mkdir -p .devnet/l2/configs
      "${compose_cmd[@]}" up -d --no-build --remove-orphans setup-l2
      setup_l2_status="$(docker wait setup-l2)"
      if [ "$setup_l2_status" != "0" ]; then
        docker logs setup-l2 >&2 || true
        exit "$setup_l2_status"
      fi

      if [ -n "$upgrade_signal_env_files" ]; then
        UPGRADE_SIGNAL_ENV_FILES="$upgrade_signal_env_files" ./etc/scripts/devnet/upgrade-signal.sh setup
      else
        ./etc/scripts/devnet/upgrade-signal.sh setup
      fi
      "${compose_cmd[@]}" up -d --no-build --remove-orphans
    }

    case "$zk_mode" in
      dry-run)
        just --justfile {{ source_file() }} down
        just --justfile {{ source_file() }} _build-setup-image
        just --justfile {{ source_file() }} _build-rust-images "devnet" "dev"
        DEVNET_SP1_CLUSTER_API_ENDPOINT= DEVNET_CLI_S3_BUCKET= \
          DEVNET_NETWORK_PRIVATE_KEY= DEVNET_USE_KMS_REQUESTER=false \
          DEVNET_AWS_ACCESS_KEY_ID= DEVNET_AWS_SECRET_ACCESS_KEY= DEVNET_AWS_SESSION_TOKEN= \
          start_devnet_with_upgrade_signal
        ;;
      cluster)
        if [ -z "${AWS_ACCESS_KEY_ID:-}" ] || [ -z "${AWS_SECRET_ACCESS_KEY:-}" ]; then
          echo "ERROR: zk=cluster requires AWS credentials in the caller environment." >&2
          echo "Run your role/session setup first, then retry: just devnet up zk=cluster" >&2
          exit 1
        fi
        cluster_config="${ZK_CLUSTER_CONFIG:-${BASE_CLUSTER_CONFIG_DIR:-$HOME/.config/base/clusters}/devnet.yaml}"
        if [ ! -f "$cluster_config" ]; then
          echo "ERROR: ZK cluster YAML not found: $cluster_config" >&2
          echo "Create it with non-secret cluster settings, then retry:" >&2
          echo "  mkdir -p \"$(dirname "$cluster_config")\"" >&2
          echo "  cat > \"$cluster_config\" <<'EOF'" >&2
          echo "sp1:" >&2
          echo "  cluster_api_endpoint: https://your-sp1-cluster.example" >&2
          echo "  cluster_timeout_hours: 24" >&2
          echo "artifact:" >&2
          echo "  s3_bucket: your-devnet-zk-artifact-bucket" >&2
          echo "  s3_region: us-east-1" >&2
          echo "aws:" >&2
          echo "  default_region: us-east-1" >&2
          echo "EOF" >&2
          exit 1
        fi
        cluster_env="$(mktemp)"
        trap 'rm -f "$cluster_env"' EXIT
        python3 {{ _yaml_to_env }} "$cluster_config" "$cluster_env" \
          --map sp1.cluster_api_endpoint=DEVNET_SP1_CLUSTER_API_ENDPOINT \
          --map sp1.cluster_timeout_hours=DEVNET_SP1_CLUSTER_TIMEOUT_HOURS \
          --map artifact.s3_bucket=DEVNET_CLI_S3_BUCKET \
          --map artifact.s3_region=DEVNET_CLI_S3_REGION \
          --map aws.endpoint_url=DEVNET_AWS_ENDPOINT_URL \
          --map aws.default_region=DEVNET_AWS_DEFAULT_REGION \
          --map prover.default_sequence_window=DEFAULT_SEQUENCE_WINDOW \
          --map logging.rust_log=RUST_LOG \
          --default DEVNET_SP1_CLUSTER_TIMEOUT_HOURS=24 \
          --default DEVNET_CLI_S3_REGION=us-east-1 \
          --default DEVNET_AWS_DEFAULT_REGION=us-east-1 \
          --require DEVNET_SP1_CLUSTER_API_ENDPOINT \
          --require DEVNET_CLI_S3_BUCKET \
          --deny aws.access_key_id \
          --deny aws.secret_access_key \
          --deny aws.session_token
        just --justfile {{ source_file() }} down
        just --justfile {{ source_file() }} _build-setup-image
        just --justfile {{ source_file() }} _build-rust-images "devnet" "dev"
        DEVNET_NETWORK_PRIVATE_KEY= DEVNET_USE_KMS_REQUESTER=false \
          DEVNET_AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID" \
          DEVNET_AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY" \
          DEVNET_AWS_SESSION_TOKEN="${AWS_SESSION_TOKEN:-}" \
          UPGRADE_SIGNAL_ENV_FILES="$cluster_env" \
          start_devnet_with_upgrade_signal --env-file "$cluster_env"
        ;;
      network)
        if [ -z "${NETWORK_PRIVATE_KEY:-}" ]; then
          echo "ERROR: zk=network requires NETWORK_PRIVATE_KEY in the caller environment." >&2
          echo "Export a funded Succinct Network requester key, then retry:" >&2
          echo "  export NETWORK_PRIVATE_KEY=0x..." >&2
          echo "  just devnet up zk=network" >&2
          echo "See docs/guides/STANDALONE_PROVING.md for requester-key setup." >&2
          exit 1
        fi
        for elf in range-elf-embedded aggregation-elf; do
          elf_path="crates/proof/succinct/elf/${elf}"
          if [ ! -s "$elf_path" ]; then
            echo "ERROR: real SP1 ELF not found: ${elf_path}" >&2
            echo "Paid network proving requires reproducible ELFs. Build them first:" >&2
            echo "  just succinct build-elfs" >&2
            exit 1
          fi
        done
        just --justfile {{ source_file() }} down
        just --justfile {{ source_file() }} _build-setup-image
        # Force real ELFs into the zk-host image: paid network requests must
        # never run against a stub-backed worker.
        just --justfile {{ source_file() }} _build-rust-images "devnet" "dev" "1"
        L2_BASE_BERYL_BLOCK= L2_BASE_COBALT_BLOCK= \
          DEVNET_SP1_CLUSTER_API_ENDPOINT= DEVNET_CLI_S3_BUCKET= \
          DEVNET_NETWORK_PRIVATE_KEY="$NETWORK_PRIVATE_KEY" \
          DEVNET_USE_KMS_REQUESTER="${USE_KMS_REQUESTER:-false}" \
          DEVNET_AWS_ACCESS_KEY_ID= DEVNET_AWS_SECRET_ACCESS_KEY= DEVNET_AWS_SESSION_TOKEN= \
          start_devnet_with_upgrade_signal
        ;;
      *)
        echo "ERROR: zk must be 'dry-run', 'cluster', or 'network' (got '${zk_mode}')" >&2
        exit 1
        ;;
    esac

[private]
_build-contracts:
    cd crates/utilities/test-utils/contracts && forge soldeer install && forge build
