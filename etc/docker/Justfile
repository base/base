    flashblocks-websocket-client ws://localhost:${L2_BUILDER_FLASHBLOCKS_PORT}

# Stream logs from devnet containers (optionally specify container names)
logs *containers:
    docker compose {{ _env }} {{ _ha }} logs -f {{ containers }}

# Stream logs from the primary unified sequencer
sequencer-logs:
    docker compose {{ _env }} {{ _ha }} logs -f base-builder

# Follow the active raft leader's unified sequencer logs, switching automatically on failover
follow-leader:
    ./etc/scripts/devnet/follow-leader.sh

# Stop the active sequencer and transfer raft leadership (optionally to node 0, 1, or 2)
transfer-leader to='':
    ./etc/scripts/devnet/transfer-leader.sh {{ to }}

# TUI dashboard: HA conductor cluster monitor (requires devnet running)
conductor:
    cargo run --quiet -p basectl -- -c devnet monitor conductor

# Stops devnet+ingress, deletes data, and starts fresh with full ingress stack
ingress: ingress-down _build-setup-image (_build-rust-images "ingress" "dev")
    mkdir -p .devnet
    docker compose {{ _env }} {{ _base }} -f etc/docker/docker-compose.ingress.yml up -d --no-build

# Stops devnet+ingress and deletes all data
ingress-down:
    -docker compose {{ _env }} {{ _base }} -f etc/docker/docker-compose.ingress.yml down
    -[ ! -d .devnet ] || docker run --rm -v "$(pwd)/.devnet:/devnet" alpine sh -c 'rm -rf /devnet/*'

# Stream logs from devnet+ingress containers (optionally specify container names)
ingress-logs *containers:
    docker compose {{ _env }} {{ _base }} -f etc/docker/docker-compose.ingress.yml logs -f {{ containers }}

# Builds one of the shared Rust service images (default: base)
build-image target='base' profile='dev':
    #!/usr/bin/env bash
    set -euo pipefail
    elf_require=1
    case "{{ profile }}" in
      dev|profiling)
        case "{{ target }}" in
          zk-host|devnet) elf_require=0 ;;
        esac
        ;;
    esac
    PROFILE="{{ profile }}" ZK_HOST_PROFILE=release BASE_SUCCINCT_ELF_REQUIRE="${elf_require}" docker buildx bake -f etc/docker/docker-bake.hcl "{{ target }}" --load

# Prepares Docker images needed for system tests
pull-images:
    docker build --load -t devnet-setup:local -f etc/docker/Dockerfile.devnet .
    docker pull ghcr.io/paradigmxyz/reth:v1.11.4
    docker pull sigp/lighthouse:v8.0.1

# Runs system tests (requires Docker)
tests: _install-nextest _build-contracts
    cargo nextest run -p base-system-tests

# Runs system tests with ci profile for minimal disk usage
tests-ci: _install-nextest _build-contracts
    cargo nextest run -P ci --locked -p base-system-tests --cargo-profile ci --no-fail-fast

# Runs system test benchmarks
bench name:
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ name }}" in
      b20-zk-proving) cargo bench -p base-system-tests --bench b20_zk_proving ;;
      *) echo "unknown system test bench: {{ name }}" >&2; exit 1 ;;
    esac

[private]
_install-nextest:
    @command -v cargo-nextest >/dev/null 2>&1 || cargo install cargo-nextest

[private]
_build-setup-image:
    docker build --load -t devnet-setup:local -f etc/docker/Dockerfile.devnet .

[private]
_build-profiling-tools-image:
    docker buildx bake -f etc/docker/docker-bake.hcl profiling-tools --load

[private]
_build-rust-images group profile='dev':
    #!/usr/bin/env bash
    set -euo pipefail
    elf_require=1
    case "{{ profile }}" in
      dev|profiling)
        case "{{ group }}" in
          devnet|ingress) elf_require=0 ;;
        esac
        ;;
    esac
    PROFILE="{{ profile }}" ZK_HOST_PROFILE=release BASE_SUCCINCT_ELF_REQUIRE="${elf_require}" docker buildx bake -f etc/docker/docker-bake.hcl "{{ group }}" --load

[private]
_build-nitro-images profile='dev':
    PROFILE="{{ profile }}" docker buildx bake -f etc/docker/docker-bake.hcl proposer prover-service nitro-host-local --load

[private]
_up-devnet compose_profile mode:
    #!/usr/bin/env bash
    set -euo pipefail
    compose_profile={{ quote(compose_profile) }}
    devnet_mode={{ quote(mode) }}

    # Denim is scheduled through devnet-env. Zenith mode additionally schedules the
    # genesis-only Zenith gate used for future hardfork feature testing.
    case "$devnet_mode" in
      default) ;;
      zenith)
        export L2_BASE_DENIM_BLOCK="${L2_BASE_DENIM_BLOCK-23}"
        export L2_BASE_ZENITH_BLOCK="${L2_BASE_ZENITH_BLOCK:-50}"
        ;;
      *)
        echo "ERROR: mode must be 'default' or 'zenith' (got '${devnet_mode}')" >&2
        exit 1
        ;;
    esac

    case "$compose_profile" in
      ha)
        compose_files=({{ _ha }})
        # Any of the three conductor-managed sequencers can be the leader/builder,
        # so ingress nodes fan validity (advanced) txs out to all of them.
        export VALIDITY_BUILDER_RPC_URLS="http://base-builder:${L2_BUILDER_HTTP_PORT},http://base-sequencer-1:${L2_SEQ1_HTTP_PORT},http://base-sequencer-2:${L2_SEQ2_HTTP_PORT}"
        ;;
      base) compose_files=({{ _base }}) ;;
      *)
        echo "ERROR: compose profile must be 'ha' or 'base' (got '${compose_profile}')" >&2
        exit 1
        ;;
    esac

    # Starts L1 + setup, deploys the upgrade-signal contract, then starts the rest.
    start_devnet_with_upgrade_signal() {
      local setup_l2_status
      local compose_cmd=(docker compose {{ _env }} "${compose_files[@]}")

      mkdir -p .devnet/l2/configs
      "${compose_cmd[@]}" up -d --no-build --remove-orphans setup-l1 l1-el l1-cl l1-vc
      "${compose_cmd[@]}" up -d --no-build --remove-orphans setup-l2
      setup_l2_status="$(docker wait setup-l2)"
      if [ "$setup_l2_status" != "0" ]; then
        docker logs setup-l2 >&2 || true
        exit "$setup_l2_status"
      fi

      ./etc/scripts/devnet/upgrade-signal.sh setup
      "${compose_cmd[@]}" up -d --no-build --remove-orphans
    }

    just --justfile {{ source_file() }} down
    just --justfile {{ source_file() }} _build-setup-image
    just --justfile {{ source_file() }} _build-rust-images "devnet" "dev"
    start_devnet_with_upgrade_signal

[private]
_build-contracts:
    cd crates/utilities/test-utils/contracts && forge soldeer install && forge build
