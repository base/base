FROM public.ecr.aws/docker/library/golang:1.26 AS builder

# Install build dependencies for CGO (required for BLS library)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git make gcc g++ libc6-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG ETH_BEACON_GENESIS_COMMIT=f57c0fb4606f9a28e5eecb61546efa9b658183b2
ARG ETH2_VAL_TOOLS_TAG=v0.2.0
ARG ETH2_VAL_TOOLS_COMMIT=db4f5fa6b8a6096a5f22c0a60f6494bf489c407b

# Build eth-beacon-genesis from source (has replace directives, can't use go install)
WORKDIR /build
RUN git clone https://github.com/ethpandaops/eth-beacon-genesis.git . && \
    git checkout "${ETH_BEACON_GENESIS_COMMIT}" && \
    test "$(git rev-parse HEAD)" = "${ETH_BEACON_GENESIS_COMMIT}"
ENV CGO_ENABLED=1
RUN go build -o /go/bin/eth-genesis-state-generator ./cmd/eth-genesis-state-generator

# Build eth2-val-tools for validator keystore generation
WORKDIR /build2
RUN git clone https://github.com/protolambda/eth2-val-tools.git --branch "${ETH2_VAL_TOOLS_TAG}" --single-branch . && \
    git switch -c "branch-${ETH2_VAL_TOOLS_TAG}" "${ETH2_VAL_TOOLS_COMMIT}" && \
    test "$(git rev-parse HEAD)" = "${ETH2_VAL_TOOLS_COMMIT}"
RUN go build -o /go/bin/eth2-val-tools .

# Build contracts using Foundry
# The foundry image is Ubuntu-based and multi-arch (amd64/arm64)
FROM ghcr.io/foundry-rs/foundry:v1.7.1 AS contracts-builder

ARG CONTRACTS_COMMIT=

WORKDIR /contracts
RUN git clone https://github.com/base/contracts.git . && \
    if [ -n "${CONTRACTS_COMMIT}" ]; then \
      echo "Pinned contracts commit: ${CONTRACTS_COMMIT}" && \
      git checkout "${CONTRACTS_COMMIT}"; \
    else \
      echo "CONTRACTS_COMMIT not set — using latest main ($(git rev-parse --short HEAD))"; \
    fi

# Install deps from the contracts justfile (single source of truth for pins).
# --no-git avoids submodule machinery and git user/email config requirement.
RUN grep -A 20 '^deps:' justfile \
    | grep 'github\.com/' \
    | sed 's/\\$//' \
    | tr -d ' ' \
    | xargs forge install --no-git
RUN forge build

FROM ghcr.io/foundry-rs/foundry:v1.7.1

USER root
RUN git config --global --add safe.directory /contracts
RUN apt-get update && apt-get install -y --no-install-recommends \
    jq gettext-base curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Go tools from builder stage
COPY --from=builder /go/bin/eth-genesis-state-generator /usr/local/bin/
COPY --from=builder /go/bin/eth2-val-tools /usr/local/bin/

# forge and cast are already present in the foundry image

# Copy contracts source + compiled artifacts (forge script needs both)
COPY --from=contracts-builder /contracts/ /contracts/

# Copy devnet L2Genesis wrapper script into contracts
COPY etc/scripts/devnet/L2GenesisDevnet.s.sol /contracts/scripts/L2GenesisDevnet.s.sol

# Create working directories
RUN mkdir -p /config /output /shared /templates

# Copy templates
COPY etc/scripts/devnet/templates/ /templates/

# Copy setup scripts
COPY etc/scripts/devnet/ /usr/local/bin/
RUN chmod +x /usr/local/bin/*.sh

# Reset the inherited ENTRYPOINT from the foundry base image (ENTRYPOINT ["forge"]).
# Without this, commands like `setup-l2.sh` would run as `forge setup-l2.sh`.
ENTRYPOINT []
