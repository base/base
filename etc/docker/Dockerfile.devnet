FROM public.ecr.aws/docker/library/golang:1.26-alpine AS builder

# Install build dependencies for CGO (required for BLS library)
RUN apk add --no-cache git make gcc g++ musl-dev linux-headers curl ca-certificates

ARG ETH_BEACON_GENESIS_COMMIT=f57c0fb4606f9a28e5eecb61546efa9b658183b2
ARG ETH2_VAL_TOOLS_TAG=v0.2.0
ARG ETH2_VAL_TOOLS_COMMIT=db4f5fa6b8a6096a5f22c0a60f6494bf489c407b
# Build eth-beacon-genesis from source (has replace directives, can't use go install)
WORKDIR /build
RUN git clone https://github.com/ethpandaops/eth-beacon-genesis.git . && \
    git checkout "${ETH_BEACON_GENESIS_COMMIT}" && \
    test "$(git rev-parse HEAD)" = "${ETH_BEACON_GENESIS_COMMIT}"
ENV CGO_ENABLED=1
RUN go build -o /go/bin/eth-genesis-state-generator ./cmd/eth-genesis-state-generator

# Build eth2-val-tools for validator keystore generation
WORKDIR /build2
RUN git clone https://github.com/protolambda/eth2-val-tools.git --branch "${ETH2_VAL_TOOLS_TAG}" --single-branch . && \
    git switch -c "branch-${ETH2_VAL_TOOLS_TAG}" "${ETH2_VAL_TOOLS_COMMIT}" && \
    test "$(git rev-parse HEAD)" = "${ETH2_VAL_TOOLS_COMMIT}"
RUN go build -o /go/bin/eth2-val-tools .

# Build the integrated offline setup from the Base-specific Optimism branch.
# Pin the source revision so setup image builds are reproducible.
FROM public.ecr.aws/docker/library/golang:1.26-alpine AS base-devnet-builder
RUN apk add --no-cache git ca-certificates
ADD https://github.com/base/optimism.git#0066b17c3fe0cbb5ea935de6d5b18d4fc86dc439 /op-deployer
WORKDIR /op-deployer
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /out/op-deployer ./op-deployer/cmd/op-deployer && \
    CGO_ENABLED=0 go build -o /out/extract-artifacts ./op-deployer/cmd/extract-artifacts
# Avoid unpacking contract artifacts on every fresh devnet startup.
RUN /out/extract-artifacts /contract-artifacts && \
    mv /contract-artifacts/bundle-*/forge-artifacts /artifacts

FROM public.ecr.aws/docker/library/alpine:3.21.3

RUN apk add --no-cache bash jq curl

# Compose devnets and system tests share the integrated offline generator.
COPY --from=base-devnet-builder /out/op-deployer /usr/local/bin/
COPY --from=base-devnet-builder /artifacts /opt/base-devnet-artifacts
ENV BASE_DEVNET_ARTIFACTS=/opt/base-devnet-artifacts

# Copy the built binaries
COPY --from=builder /go/bin/eth-genesis-state-generator /usr/local/bin/
COPY --from=builder /go/bin/eth2-val-tools /usr/local/bin/

# Create working directories
RUN mkdir -p /config /output /shared

# Copy setup scripts
COPY etc/scripts/devnet/ /usr/local/bin/
RUN chmod +x /usr/local/bin/*.sh
