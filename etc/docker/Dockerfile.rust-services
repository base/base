FROM public.ecr.aws/docker/library/debian:trixie-slim AS runtime-base
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM runtime-base AS base
COPY --from=base-image-builder /app/base ./base
COPY --from=base-image-builder /app/snapshotter ./snapshotter
COPY etc/scripts/devnet/base-entrypoint.sh ./base-entrypoint.sh
RUN chmod +x ./base-entrypoint.sh
ENTRYPOINT ["/app/base"]
CMD ["rpc"]

FROM runtime-base AS basectl
COPY --from=basectl-builder /app/basectl ./basectl
ENTRYPOINT ["./basectl"]

FROM runtime-base AS snapshotter
COPY --from=snapshotter-builder /app/snapshotter ./snapshotter
ENTRYPOINT ["./snapshotter"]

FROM runtime-base AS proposer
COPY --from=proposer-builder /app/base-proposer ./base-proposer
EXPOSE 9090
ENTRYPOINT ["./base-proposer"]

FROM runtime-base AS websocket-proxy
COPY --from=websocket-proxy-builder /app/websocket-proxy ./websocket-proxy
ENTRYPOINT ["./websocket-proxy"]

FROM runtime-base AS ingress-rpc
COPY --from=ingress-rpc-builder /app/ingress-rpc ./ingress-rpc
ENTRYPOINT ["./ingress-rpc"]

FROM runtime-base AS audit-archiver
COPY --from=audit-archiver-builder /app/audit-archiver ./audit-archiver
ENTRYPOINT ["./audit-archiver"]

FROM runtime-base AS batcher
COPY --from=batcher-builder /app/base-batcher ./base-batcher
ENTRYPOINT ["./base-batcher"]

FROM runtime-base AS sidecrush
COPY --from=sidecrush-builder /app/sidecrush ./sidecrush
ENTRYPOINT ["./sidecrush"]

FROM runtime-base AS prover-service
COPY --from=prover-service-builder /app/base-prover-service ./base-prover-service
EXPOSE 9000 9001
ENTRYPOINT ["./base-prover-service"]
