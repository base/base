FROM public.ecr.aws/docker/library/golang:1.24.13-alpine3.22 AS builder

RUN apk add --no-cache git
WORKDIR /app

# Match the op-batcher source pin used by Base mainnet infrastructure.
ARG OP_BATCHER_TAG=op-batcher/v1.16.5
ARG OP_BATCHER_COMMIT=abe047afc995e0e22abf5ea9b157e267e907d494
RUN git clone --depth 1 --branch "${OP_BATCHER_TAG}" https://github.com/ethereum-optimism/optimism.git . && \
    test "$(git rev-parse HEAD)" = "${OP_BATCHER_COMMIT}"
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-X main.Version=${OP_BATCHER_TAG#op-batcher/} -X main.GitCommit=${OP_BATCHER_COMMIT} -X main.GitDate=$(git show -s --format=%ct HEAD)" \
    -o /bin/op-batcher ./op-batcher/cmd

FROM public.ecr.aws/docker/library/alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/op-batcher /bin/op-batcher
ENTRYPOINT ["/bin/op-batcher"]
