# Optional ca_bundle secret mounts support custom CA bundles; see etc/docker/README.md.
FROM 652969937640.dkr.ecr.us-east-1.amazonaws.com/containers/golang:v1-24-ub22 AS builder
# Export CA bundle env vars only when /run/secrets/ca_bundle is mounted, then exec the RUN string.
# The secret mount itself must still be declared on each network-fetching RUN.
SHELL ["/bin/sh", "-c", "if [ -f /run/secrets/ca_bundle ]; then export SSL_CERT_FILE=/run/secrets/ca_bundle CURL_CA_BUNDLE=/run/secrets/ca_bundle CARGO_HTTP_CAINFO=/run/secrets/ca_bundle GIT_SSL_CAINFO=/run/secrets/ca_bundle NODE_EXTRA_CA_CERTS=/run/secrets/ca_bundle; fi; exec /bin/sh -c \"$1\"", "--"]

WORKDIR /app

ENV CGO_ENABLED=0
ENV GOPROXY=https://gomodules.cbhq.net/

COPY --from=base-routing proxyd/go.mod proxyd/go.sum ./proxyd/
RUN --mount=type=secret,id=ca_bundle,target=/run/secrets/ca_bundle,required=false \
    cd proxyd && go mod download

COPY --from=base-routing proxyd/ ./proxyd/
RUN --mount=type=secret,id=ca_bundle,target=/run/secrets/ca_bundle,required=false \
    cd proxyd && make proxyd

FROM alpine:3.20

RUN --mount=type=secret,id=ca_bundle,target=/run/secrets/ca_bundle,required=false \
    if [ -f /run/secrets/ca_bundle ]; then export SSL_CERT_FILE=/run/secrets/ca_bundle; fi && \
    apk add --no-cache ca-certificates curl

COPY --from=builder /app/proxyd/bin/proxyd /bin/proxyd

ENTRYPOINT ["/bin/proxyd"]
